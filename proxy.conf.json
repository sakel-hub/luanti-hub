{
  "/api": {
    "target": "https://luantihub.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "info",
    "headers": {
      "Accept": "application/json",
      "User-Agent": "LuantiHub/1.0 (+https://luantihub.org)"
    }
  },
  "/mirror-api": {
    "target": "https://contentdb.milcho.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/mirror-api": "/api"
    },
    "headers": {
      "Accept": "application/json",
      "User-Agent": "LuantiHub/1.0 (+https://luantihub.org)"
    }
  },
  "/cdb-api": {
    "target": "https://content.luanti.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/cdb-api": "/api"
    },
    "headers": {
      "Accept": "application/json",
      "User-Agent": "LuantiHub/1.0 (+https://luantihub.org)"
    }
  }
}
