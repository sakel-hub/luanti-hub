{
  "/api": {
    "target": "https://luantihub.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "info",
    "headers": {
      "User-Agent": "LuantiHub/1.0 (+https://luantihub.org)"
    }
  },
  "/mirror-api": {
    "target": "https://contentdb.milcho.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/mirror-api": "/api"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "/cdb-api": {
    "target": "https://content.luanti.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/cdb-api": "/api"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "/blog-api": {
    "target": "https://blog.luanti.org",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/blog-api": ""
    },
    "headers": {
      "Accept": "application/rss+xml, application/xml, application/feed+json, application/json, text/html, */*",
      "User-Agent": "LuantiHub/1.0 (+https://luantihub.org)"
    }
  }
}
