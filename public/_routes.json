{
  "version": 1,
  "include": [
    "/api/*",
    "/package/*",
    "/packages/*",
    "/games",
    "/mods",
    "/texture-packs",
    "/git",
    "/setup",
    "/submit",
    "/legal",
    "/sitemap.xml",
    "/.env*",
    "/.git*",
    "/wp-admin*",
    "/wp-login*",
    "/wp-content*",
    "/wp-includes*",
    "/phpmyadmin*"
  ],
  "exclude": [
    "/assets/*",
    "/icons/*",
    "/favicon.ico",
    "/logo.svg",
    "/manifest.webmanifest",
    "/ngsw.json",
    "/ngsw-worker.js",
    "/custom-sw.js",
    "/safety-worker.js",
    "/worker-basic.min.js",
    "/robots.txt",
    "/.well-known/*"
  ]
}
