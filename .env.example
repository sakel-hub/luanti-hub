# =============================================================================
# LUANTIHUB CLOUDFLARE PAGES ENVIRONMENT VARIABLES & SECRETS (TEMPLATE)
# Copy to `.env` or import directly in Cloudflare Pages -> Settings -> Variables and secrets
# =============================================================================

# 1. Core Security & Session Signing Secret (HMAC-SHA256 256-bit key)
SESSION_SECRET=replace_with_32_byte_random_hex_secret

# 2. Instant Kill Switch API Bearer Secret (for emergency CLI/webhook takedowns)
KILL_SWITCH_SECRET=replace_with_32_byte_random_hex_killswitch_secret

# 3. Admin Handles & Direct Admin Passphrase
ADMIN_USERS=sakel,sakel-hub,juraj
ADMIN_SECRET=replace_with_admin_verification_secret

# =============================================================================
# 4. OPTIONAL 1-CLICK OAUTH REDIRECTS FOR ALL SUPPORTED PROVIDERS
# =============================================================================

# --- GitHub OAuth (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://luanti-hub.pages.dev/api/auth/github/callback

# --- Codeberg / Forgejo OAuth (https://codeberg.org/user/settings/applications) ---
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
CODEBERG_REDIRECT_URI=https://luanti-hub.pages.dev/api/auth/codeberg/callback

# --- GitLab OAuth (https://gitlab.com/-/user_settings/applications) ---
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=https://luanti-hub.pages.dev/api/auth/gitlab/callback

# --- ContentDB OAuth (https://content.luanti.org/oauth/apps/) ---
CONTENTDB_CLIENT_ID=
CONTENTDB_CLIENT_SECRET=
CONTENTDB_REDIRECT_URI=https://luanti-hub.pages.dev/api/auth/contentdb/callback
